# ─────────────────────────────────────────────────────────────
# DefacerID — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
#
# LOCAL DEVELOPMENT (SQLite — no setup needed):
#   DATABASE_URL=file:./db/custom.db
#   (keep the schema on SQLite: `bun run db:use-sqlite`)
#
# PRODUCTION (Supabase / Vercel):
#   1. Switch the schema to PostgreSQL:  `bun run db:use-postgres`
#   2. Set the two URLs below from your Supabase project
#      (Project Settings → Database → Connection string)
#   3. Push the schema:  `bun run db:push`
#   4. Deploy to Vercel and add the same env vars in the Vercel dashboard.
# ─────────────────────────────────────────────────────────────

# SQLite (local sandbox / default):
DATABASE_URL="file:./db/custom.db"

# ── Supabase (production) ────────────────────────────────────
# TWO pooler URLs, both on pooler.supabase.com (IPv4, reachable from Vercel).
# DO NOT use the direct connection (db.xxx.supabase.co) — IPv6-only, unreachable
# from Vercel's build environment.
#
# Find them in: Supabase dashboard → Project Settings → Database → Connection string
#
# DATABASE_URL  → TRANSACTION pooler (port 6543) for runtime serverless queries.
#                 Append ?pgbouncer=true&connection_limit=1 to multiplex connections
#                 and avoid the EMAXCONSESSION (pool_size: 15) error on Vercel.
DATABASE_URL="postgresql://postgres.xxxxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL    → SESSION pooler (port 5432) for migrations (prisma db push during build).
#                 Session mode supports the prepared statements migrations need.
DIRECT_URL="postgresql://postgres.xxxxx:your-password@aws-0-region.pooler.supabase.com:5432/postgres"

# ── Auth (admin login) ───────────────────────────────────────
# Admin credentials — set these in Vercel env vars so they never live in source.
# If unset, the app falls back to demo defaults (GadaLuBau / slametwkw) which
# should ONLY be used for local development.
# ADMIN_USERNAME="your-admin-username"
# ADMIN_PASSWORD="a-strong-password"
#
# HMAC secret signing admin session tokens. Set a long random string in production.
# AUTH_SECRET="change-me-to-a-long-random-string"
